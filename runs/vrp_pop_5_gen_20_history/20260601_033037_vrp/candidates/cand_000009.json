lta:\n                            min_delta = delta\n                            best_p = pos\n                    route_best.append((min_delta, r_idx, best_p))\n            # sort by delta\n            route_best.sort(key=lambda x: x[0])\n            best = route_best[0][0]\n            second = route_best[1][0] if len(route_best) > 1 else best\n            regret = second - best\n            if regret > best_regret:\n                best_regret = regret\n                best_cust = cust\n                best_delta = best\n                best_route_idx = route_best[0][1]\n                best_pos = route_best[0][2]\n\n        # insert customer\n        route = routes[best_route_idx]\n        route.insert(best_pos, best_cust)\n        unassigned.remove(best_cust)\n        report_if_better()\n\n    # Improvement: relocate from longest route to others\n    for _ in range(n):\n        # find longest route\n        max_dist = 0\n        max_idx = 0\n        for i, r in enumerate(routes):\n            d = route_distance(r)\n            if d > max_dist:\n                max_dist = d\n                max_idx = i\n        # try to move each customer from longest route to another\n        route_to_shrink = routes[max_idx]\n        if len(route_to_shrink) == 0:\n            break\n        moved = False\n        for cust in list(route_to_shrink):  # iterate over copy\n            if moved:\n                break\n            # test removal effect\n            # try removal from current position\n            pos = route_to_shrink.index(cust)\n            # compute delta removal\n            if len(route_to_shrink) == 1:\n                delta_rem = -distance_matrix[0, cust] - distance_matrix[cust, 0]\n            else:\n                if pos == 0:\n                    prev = 0\n                    next = route_to_shrink[1]\n                elif pos == len(route_to_shrink)-1:\n                    prev = route_to_shrink[-2]\n                    next = 0\n                else:\n