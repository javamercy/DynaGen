trix[route[a], route[a + 1]]\n        return total\n\n    def compute_max():\n        maxd = 0\n        for r in routes:\n            d = route_dist(r)\n            if d > maxd:\n                maxd = d\n        return maxd\n\n    best_max = compute_max()\n    best_routes = [list(r) for r in routes]\n    report_best_vrp(best_routes)\n\n    # --- Improvement: round-robin best-improvement ---\n    max_passes = n * n\n    for _ in range(max_passes):\n        dists = [route_dist(r) for r in routes]\n        current_max = max(dists)\n        improved = False\n\n        # Order routes by distance descending, then index ascending\n        order = sorted(range(len(routes)), key=lambda i: (-dists[i], i))\n\n        # Best 2-opt on each route\n        for idx in order:\n            route = routes[idx]\n            if len(route) <= 3:\n                continue\n            best_local = route_dist(route)\n            best_route = route[:]\n            for i in range(1, len(route) - 2):\n                for j in range(i + 1, len(route) - 1):\n                    new_route = route[:i] + route[i:j+1][::-1] + route[j+1:]\n                    new_dist = route_dist(new_route)\n                    if new_dist < best_local:\n                        best_local = new_dist\n                        best_route = new_route\n            if best_local < route_dist(route):\n                routes[idx] = best_route\n                new_max = compute_max()\n                if new_max < best_max:\n                    best_max = new_max\n                    best_routes = [list(r) for r in routes]\n                    report_best_vrp(best_routes)\n                improved = True\n                break  # restart pass after any improvement\n\n        if improved:\n            continue\n\n        # Recompute dists and order\n        dists = [route_dist(r) for r in routes]\n        current_max = max(dists)\n        order = sorted(range(len(routes)), key=lambda i: (-dists[i], i))\n        longest_idx =