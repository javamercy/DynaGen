tes) < truck_count:\n        routes.append([0, 0])\n\n    # Compute current distances and best solution\n    current_dist = [route_distance(r) for r in routes]\n    best_routes = [list(r) for r in routes]\n    best_max = max(current_dist)\n    # report_best_vrp(routes)  # uncomment if function exists\n\n    # Local search (identical to parent)\n    customers = list(range(1, n))\n    n_cust = len(customers)\n    max_iters = 10 * n_cust * truck_count\n    improved = True\n    iters = 0\n    while improved and iters < max_iters:\n        improved = False\n        iters += 1\n\n        # Relocate moves\n        for r1 in range(truck_count):\n            route1 = routes[r1]\n            if len(route1) <= 2:\n                continue\n            for idx in range(1, len(route1)-1):\n                cust = route1[idx]\n                old_dist1 = current_dist[r1]\n                new_route1 = route1[:idx] + route1[idx+1:]\n                new_dist1 = route_distance(new_route1)\n                for r2 in range(truck_count):\n                    if r2 == r1:\n                        continue\n                    route2 = routes[r2]\n                    old_dist2 = current_dist[r2]\n                    cost, pos = min(\n                        (distance_matrix[route2[i-1], cust] + distance_matrix[cust, route2[i]] - distance_matrix[route2[i-1], route2[i]], i)\n                        for i in range(1, len(route2))\n                    )\n                    new_route2 = route2[:pos] + [cust] + route2[pos:]\n                    new_dist2 = old_dist2 + cost\n                    other_dists = [current_dist[i] for i in range(truck_count) if i not in (r1, r2)]\n                    new_max = max(new_dist1, new_dist2, *other_dists)\n                    if new_max < best_max:\n                        routes[r1] = new_route1\n                        routes[r2] = new_route2\n                        current_dist[r1] = new_dist1\n                        current_dist[r2] = new_dist2\n     