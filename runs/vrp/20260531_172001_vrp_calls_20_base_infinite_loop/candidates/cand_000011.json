   def total_routes_length():\n        return [route_length(r) for r in routes]\n    \n    # Regret insertion\n    unassigned = set(customers)\n    while unassigned:\n        best_customer = None\n        best_regret = -1\n        best_pos = None\n        best_route_idx = None\n        best_insertion_cost = None\n        for cust in unassigned:\n            costs = []  # list of (cost, route_idx, pos_idx)\n            for r_idx, route in enumerate(routes):\n                # consider all insertion positions (after first node, before last)\n                for pos in range(1, len(route)):\n                    # insertion cost: dist(prev,cust) + dist(cust,next) - dist(prev,next)\n                    prev = route[pos-1]\n                    next_node = route[pos]\n                    cost = distance_matrix[prev, cust] + distance_matrix[cust, next_node] - distance_matrix[prev, next_node]\n                    costs.append((cost, r_idx, pos))\n            # Sort by cost ascending\n            costs.sort(key=lambda x: x[0])\n            # There must be at least one insertion (if route is [0,0], only pos=1)\n            best_cost = costs[0][0]\n            # Regret: if only one route possible? Actually there are always truck_count routes, but all may be non-empty or empty.\n            # Second best: if len(costs) > 1, use second; else use a large number or same? regret = second - best\n            second_cost = costs[1][0] if len(costs) > 1 else best_cost + 1e9  # large regret if only one feasible\n            regret = second_cost - best_cost\n            # Keep customer with highest regret; ties: highest best insertion cost\n            if regret > best_regret or (regret == best_regret and best_insertion_cost is not None and best_cost > best_insertion_cost):\n                best_regret = regret\n                best_customer = cust\n                best_route_idx = costs[0][1]\n                best_pos = costs[0][2]\n                best_insertion_cost = best_cost\n            # Also handle ties: if regret equal and best_cost equal, choose smaller customer index for stability\n            elif regret == best_regret and best_cost == best_insertion_cost and cust < best_customer:\n                best_customer = cust\n                best_route_idx = costs[0][1]\n                best_pos = costs[0][2]\n        # Insert best_customer\n        route = routes[best_route_idx]\n        route.insert(best_pos, best_customer)\n        unassigned.remove(best_customer)\n    \n    # Improvement: local search to minimize max route distance\n    # Compute current max\n    current_max = max(route_length(r) for r in routes)\n    improved = True\n    max_iter = n * truck_count  # finite bound\n    iterations = 0\n    while improved and iterations < max_iter:\n        improved = False\n        iterations += 1\n        # Inter-route relocate: try moving a customer from one route to another\n        # To reduce max, we try to move a customer from the longest route to a shorter one\n        lengths = [route_length(r) for r in routes]\n        max_idx = np.argmax(lengths)\n        max_route = routes[max_idx]\n        # If max_route has only depot nodes, skip\n        if len(max_route) <= 2:\n            continue\n        # Try removing each customer from max_idx and inserting into other routes\n        best_delta = 0\n        best_move = None\n        for cust in max_route[1:-1]:  # customers only\n            # Temporarily remove cust, get new length of max_route\n            new_max_route = [x for x in max_route if x != cust]\n            new_max_len = route_length(new_max_route)\n            # For each other route\n            for r_idx in range(truck_count):\n                if r_idx == max_idx:\n                    continue\n                other_route = routes[r_idx]\n                # Try all insertion positions\n                for pos in range(1, len(other_route)):\n                    new_other_route = other_route[:pos] + [cust] + other_route[po