(routes[tt], dm) for tt in range(truck_count) if tt != t]\n            best_pos = None\n            best_local_max = float('inf')\n            for pos in range(1, len(route)):\n                new_route = route[:pos] + [cust] + route[pos:]\n                new_dist = route_distance(new_route, dm)\n                new_max = max(max(current_dists) if current_dists else 0, new_dist)\n                if new_max < best_local_max:\n                    best_local_max = new_max\n                    best_pos = pos\n            if best_local_max < best_new_max:\n                best_new_max = best_local_max\n                best_truck = t\n        route = routes[best_truck]\n        best_pos = None\n        best_new_dist = float('inf')\n        for pos in range(1, len(route)):\n            new_route = route[:pos] + [cust] + route[pos:]\n            new_dist = route_distance(new_route, dm)\n            if new_dist < best_new_dist:\n                best_new_dist = new_dist\n                best_pos = pos\n        if best_pos is None:\n            best_pos = len(route)\n        routes[best_truck] = route[:best_pos] + [cust] + route[best_pos:]\n    return routes\n\ndef improve_routes(routes, dm, truck_count):\n    n = dm.shape[0]\n    iterations = 0\n    max_iter = (n-1) * 2\n    improved = True\n    while improved and iterations < max_iter:\n        improved = False\n        iterations += 1\n        route_lengths = [route_distance(r, dm) for r in routes]\n        max_len = max(route_lengths)\n        # identify routes with max length (could be multiple)\n        longest_route_idx = None\n        for idx, d in enumerate(route_lengths):\n            if d == max_len:\n                longest_route_idx = idx\n                break\n        if longest_route_idx is None:\n            break\n        longest_route = routes[longest_route_idx]\n        for pos, cust in enumerate(longest_route):\n            if cust == 0:\n                continue\n            for t in range(truck_count):\n                if t == longest_route_idx:\n                    continue\n                for insert_pos in range(1, len(routes[t])):\n                    new_route_t = routes[t][:insert_pos] + [cust] + routes[t][insert_pos:]\n                    new_route_l = longest_route[:pos] + longest_route[pos+1:]\n                    if len(new_route_l) == 2:\n                        new_route_l = [0,0]\n                    else:\n                        # ensure depot at ends\n                        if new_route_l[0] != 0 or new_route_l[-1] != 0:\n                            continue\n                    new_dists = [route_distance(r, dm) for r in routes]\n                    new_dists[t] = route_distance(new_route_t, dm)\n                    new_dists[longest_route_idx] = route_distance(new_route_l, dm)\n                    new_max = max(new_dists)\n                    if new_max < max_len - 1e-12:\n                        routes[longest_route_idx] = new_route_l\n                        routes[t] = new_route_t\n                        improved = True\n                        break\n                if improved:\n                    break\n            if improved:\n                break\n    return routes\n\ndef solve_vrp(distance_matrix: np.ndarray, truck_count: int) -> list[list[int]]:\n    np.random.seed(0)\n    random.seed(0)\n    n = distance_matrix.shape[0]\n    customers = list(range(1, n))\n    if truck_count >= n - 1:\n        routes = [[0, c, 0] for c in customers]\n        while len(routes) < truck_count:\n            routes.append([0, 0])\n        report_best_vrp(routes)\n        return routes\n\n    num_cust = n - 1\n    pop_size = max(10, num_cust // 4)\n    generations = max(5, num_cust)\n    \n    pop = [np.random.uniform(size=num_cust) for _ in range(pop_size)]\n    best_routes = None\n    best_max = float('inf')\n    no_improve = 0\n    \n    for gen in range(generations):\n        fitness = []\n        all_routes = []\n        for keys in pop:\n            routes = decode(keys, truck_count, customers, distance_matrix)\n            max_dist = max(route_distance(r, distance_matrix) for r in routes)\n            fitness.append(max_dist)\n            all_routes.append(routes)\n            if max_dist < best_max - 1e-12:\n                best_max = max_dist\n                best_routes = [r[:] for r in routes]\n                report_best_vrp(best_routes)\n                no_improve = 0\n        else:\n            no_improve += 1\n        if no_improve >= 20:\n            break\n        # create next generation\n        best_idx = int(np.argmin(fitness))\n        next_pop = [pop[best_idx]]\n        for _ in range(pop_size - 1):\n            i1, i2 = np.random.choice(pop_size, 2, replace=False)\n            winner = i1 if fitness[i1] < fitness[i2] else i2\n            parent1 = pop[winner]\n            parent2 = pop[np.random.randint(pop_size)]\n            child = np.where(np.random.uniform(size=num_cust) < 0.5, parent1, parent2)\n            mut_rate = 1.0 / num_cust\n            mut_mask = np.random.uniform(size=num_cust) < mut_rate\n            child[mut_mask] = np.random.uniform(size=int(mut_mask.sum()))\n            next_pop.append(child)\n        pop = next_pop\n    \n    if best_routes is None:\n        best_routes = decode(pop[0], truck_count, customers, distance_matrix)\n        report_best_vrp(best_routes)\n    else:\n        # apply local search to best solution\n        best_routes = improve_routes(best_routes, distance_matrix, truck_count)\n        best_max = max(route_distance(r, distance_matrix) for r in best_routes)\n        report_best_vrp(best_routes)\n    return best_routes\n```\n\nImplement exactly this interface:\n\ndef solve_vrp(\n    distance_matrix: np.ndarray,  # (n, n), depot is node 0\n    truck_count: int,\n) -> list[list[int]]:\n\nRules:\n- VRP is a static multi-truck routing problem; the objective is to minimize the maximum route distance across trucks.\n- Return exactly truck_count routes.\