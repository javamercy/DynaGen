n a route\n    def best_insertion(customer, route):\n        best_pos = -1\n        best_inc = float('inf')\n        # route is list starting and ending with 0\n        for i in range(1, len(route)):\n            prev = route[i-1]\n            next_ = route[i]\n            inc = dist[prev, customer] + dist[customer, next_] - dist[prev, next_]\n            if inc < best_inc:\n                best_inc = inc\n                best_pos = i\n        return best_pos, best_inc\n    \n    # For each customer, compute regret and best insertion info across all routes\n    def compute_regret_info(customer):\n        incs = []\n        for r_idx, route in enumerate(routes):\n            pos, inc = best_insertion(customer, route)\n            incs.append((inc, pos, r_idx))\n        # sort by inc\n        incs.sort(key=lambda x: x[0])\n        if len(incs) >= 2:\n            best_inc = incs[0][0]\n            second_best_inc = incs[1][0]\n            regret = second_best_inc - best_inc\n        else:\n            best_inc = incs[0][0]\n            regret = 0.0\n        best_pos = incs[0][1]\n        best_route = incs[0][2]\n        return regret, best_inc, best_pos, best_route\n    \n    # Insert all customers\n    remaining_customers = set(customers)\n    while remaining_customers:\n        # Compute regret for each remaining customer\n        regret_list = []\n        for c in remaining_customers:\n            regret, best_inc, best_pos, best_route = compute_regret_info(c)\n            regret_list.append((regret, best_inc, -c, c, best_pos, best_route))\n        # Sort by regret descending, then best_inc descending (to break ties, larger best_inc first), then by customer index descending (since -c in tuple)\n        regret_list.sort(key=lambda x: (-x[0], -x[1], x[2]))\n        # Take the best\n        _, _, _, customer, best_pos, best_route = regret_list[0]\n        # Insert customer into its best route at best_pos\n        route = routes[best_route]\n        route.insert(best_po