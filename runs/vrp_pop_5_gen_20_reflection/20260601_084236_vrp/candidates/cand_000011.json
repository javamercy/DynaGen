\nfrom itertools import combinations\n\ndef solve_vrp(distance_matrix: np.ndarray, truck_count: int) -> list[list[int]]:\n    n = distance_matrix.shape[0]\n    customers = list(range(1, n))\n    if truck_count >= n:\n        routes = []\n        for i in range(1, n):\n            routes.append([0, i, 0])\n        for _ in range(truck_count - (n-1)):\n            routes.append([0,0])\n        return routes\n\n    # Helper: compute route distance\n    def route_distance(route):\n        if len(route) == 2:\n            return distance_matrix[0,0]\n        d = 0.0\n        for i in range(len(route)-1):\n            d += distance_matrix[route[i], route[i+1]]\n        return d\n\n    # Helper: compute max distance over all routes\n    def max_distance(routes):\n        return max(route_distance(r) for r in routes)\n\n    # Initialize clusters using farthest seed\n    # Sort customers by distance from depot descending\n    depot_dist = [(distance_matrix[0,i], i) for i in customers]\n    depot_dist.sort(reverse=True)\n    seeds = [depot_dist[i][1] for i in range(min(truck_count, len(customers)))]\n    # If more trucks than seeds, fill with dummy seeds (depot itself? but needs distinct)\n    while len(seeds) < truck_count:\n        seeds.append(customers[0])  # fallback\n    clusters = [[] for _ in range(truck_count)]\n    for idx, seed in enumerate(seeds):\n        clusters[idx].append(seed)\n    remaining = [c for c in customers if c not in seeds]\n    for cust in remaining:\n        # assign to nearest seed\n        best_dist = float('inf')\n        best_cluster = 0\n        for idx, seed in enumerate(seeds):\n            d = distance_matrix[cust, seed]\n            if d < best_dist:\n                best_dist = d\n                best_cluster = idx\n        clusters[best_cluster].append(cust)\n\n    # Build initial tours using nearest neighbor\n    def nearest_neighbor_tour(cluster):\n        if not cluster:\n            return [0,0]\n        unvisited = set(cluster)\n        current = 0\n        tour = [0]\n        while unvisited:\n            next_cust = min(unvisited, key=lambda c: distance_matrix[current, c])\n            tour.append(next_cust)\n            unvisited.remove(next_cust)\n            current = next_cust\n        tour.append(0)\n        return tour\n\n    def two_opt(route):\n        if len(route) <= 3:\n            return route\n        improved = True\n        while improved:\n            improved = False\n            for i in range(1, len(route)-2):\n                for j in range(i+1, len(route)-1):\n                    if j-i == 1:\n                        continue\n                    new_route = route[:i] + route[i:j+1][::-1] + route[j+1:]\n                    if route_distance(new_route) < route_distance(route):\n                        route = new_route\n                        improved = True\n                        break\n                if improved:\n                    break\n        return route\n\n    routes = []\n    for cluster in clusters:\n        route = nearest_neighbor_tour(cluster)\n        route = two_opt(route)\n        routes.append(route)\n    best_routes = [r[:] for r in routes]\n    best_max = max_distance(routes)\n\n    # Local search: move and swap\n    n_customers = len(customers)\n    max_iters = n_customers * truck_count * 2\n    for _ in range(max_iters):\n        improved = False\n        # Try moving each customer to another route\n        for truck_a in range(truck_count):\n            route_a = routes[truck_a]\n            if len(route_a) <= 2:  # empty route\n                continue\n            # customers in route_a (excluding depot)\n            custs_a = route_a[1:-1]\n            for cust in custs_a:\n                # Remove cust from route_a\n                new_route_a = [0] + [c for c in route_a[1:-1] if c != cust] + [0]\n                for truck_b in range(truck_count):\n                    if truck_b == truck_a:\n                        continue\n                    route_b = routes[truck_b]\n                    # Insert cust into route_b at best position\n                    best_insert = None\n                    best_dist = float('inf')\n                    for i in range(1, len(route_b)):\n                        new_route_b = route_b[:i] + [cust] + route_b[i:]\n                        d = route_distance(new_route_b)\n                        if d < best_dist:\n                            best_dist = d\n                            best_insert = i\n                    if best_insert is None:\n                        continue\n                    new_route_b = route_b[:best_insert] + [cust] + route_b[best_insert:]\n                    # Compute new max distance\n                    old_max = route_distance(route_a) if route_distance(route_a) > route_distance(route_b) else route_distance(route_b)\n                    new_max = max(route_distance(new_route_a), route_distance(new_route_b), max(route_distance(r) for idx, r in enumerate(routes) if idx not in [truck_a, truck_b]))\n                    if new_max < best_max:\n                        # Accept move\n                        routes[truck_a] = two_opt(new_route_a)\n                        routes[truck_b] = two_opt(new_route_b)\n                        best_max = new_max\n                        improved = True\n                        break\n                if improved:\n                    break\n            if improved:\n                break\n        if not improved:\n            break\n        # After each improvement, update best\n        current_max = max_distance(routes)\n        if current_max < best_max:\n            best_routes = [r[:] for r in routes]\n            best_max = current_max\n\n    # Swap customers between routes\n    for _ in range(max_iters):\n        improved = False\n        for truck_a in range(truck_count):\n            route_a = routes[truck_a]\n            if len(route_a) <= 2:\n                continue\n            custs_a = route_a[1